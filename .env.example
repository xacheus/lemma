# ==============================================================================
# LEMMA HEIGHTS APARTMENTS — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Optional: Browser Firebase Auth. Use the SAME project as the Admin SDK below.
# Leave these unset when using the built-in account/password sign-in.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Required in production: Firestore + Firebase Admin SDK (server-only).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Required in production: stable session security (server-only).
# The first administrator is appointed in the Firebase Console (see README), so there
# is no bootstrap token to configure.
LEMMA_SESSION_SECRET=replace-with-32-byte-random-hex-secret

# Required for production photo uploads: Cloudinary signed media.
# Cloud name: hpxm6znp | Signed Upload Preset: lemma_uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=hpxm6znp
CLOUDINARY_CLOUD_NAME=hpxm6znp
CLOUDINARY_UPLOAD_PRESET=lemma_uploads
CLOUDINARY_API_KEY=
# CRITICAL: Never expose CLOUDINARY_API_SECRET with NEXT_PUBLIC_
CLOUDINARY_API_SECRET=

# Optional: canonical production origin (used for links and metadata).
NEXT_PUBLIC_SITE_URL=

# Optional external notification gateways. Provider acceptance is not inbox delivery.
# Messages are marked 'sent' ONLY when a configured provider returns 2xx confirmation.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMS_WEBHOOK_URL=
SMS_API_KEY=
# Brevo transactional email: server-only API key and a verified Brevo sender.
BREVO_API_KEY=
# Use a verified address, or Name <address>. No default sender is assumed.
EMAIL_FROM=
# Optional: overrides the display name in EMAIL_FROM.
EMAIL_FROM_NAME=
