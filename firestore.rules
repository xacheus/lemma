rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // This application reads and mutates Firestore through its role-checked server
    // APIs and Admin SDK. Direct client access bypasses those projections, the
    // verified-email ownership checks, audit trail, and atomic booking/payment rules.
    // In particular, user documents contain private auth material, and cleaners'
    // permitted views are intentionally narrower than the raw documents.
    // Firebase Auth itself is unaffected. The Admin SDK bypasses these rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
